{
  "name": "colors-lamp",
  "version": "1.0.0",
  "scripts": {
    "lint": "npm run lint:html && npm run lint:css && npm run lint:js",
    "lint:html": "htmlhint \"public/**/*.html\"",
    "lint:css": "stylelint \"public/**/*.css\" --max-warnings 0",
    "lint:js": "eslint \"public/**/*.js\" \"tests/**/*.js\" jest.config.cjs --max-warnings 0",
    "test:unit": "jest --selectProjects unit --runInBand",
    "test:integration": "bash tests/run.sh",
    "test": "npm run test:unit && npm run test:integration"
  },
  "private": true,
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "eslint": "10.15.0",
    "globals": "17.14.0",
    "htmlhint": "1.9.2",
    "jest": "30.5.2",
    "jest-environment-jsdom": "30.5.2",
    "stylelint": "17.16.0"
  },
  "overrides": {
    "htmlhint": {
      "glob": "14.0.6"
    },
    "@jest/reporters": {
      "glob": "14.0.6"
    },
    "jest-config": {
      "glob": "14.0.6"
    },
    "jest-runtime": {
      "glob": "14.0.6"
    },
    "test-exclude": {
      "glob": "14.0.6",
      "minimatch": "11.0.9"
    }
  }
}
